<?xml version="1.0" encoding="utf-8"?>
<!-- Một dòng trong danh sách sản phẩm -->
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="@color/surface"
    app:cardCornerRadius="14dp"
    app:cardElevation="0dp"
    app:strokeColor="@color/border"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvName"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="2"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="Bàn phím cơ" />

            <TextView
                android:id="@+id/tvQuantity"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:textColor="@color/text_primary"
                android:textSize="18sp"
                android:textStyle="bold"
                tools:text="SL: 3"
                tools:textColor="@color/danger" />
        </LinearLayout>

        <TextView
            android:id="@+id/tvPrice"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textColor="@color/text_secondary"
            android:textSize="15sp"
            tools:text="Giá bán: 450.000 đ" />

        <!-- Các nhãn: loại, cảnh báo sắp hết hàng, ngừng kinh doanh (tự xuống dòng nếu thiếu chỗ) -->
        <com.google.android.material.chip.ChipGroup
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            app:chipSpacingHorizontal="8dp"
            app:chipSpacingVertical="6dp">

            <TextView
                android:id="@+id/tvCategory"
                style="@style/Widget.App.Tag.Category"
                tools:text="Điện tử" />

            <TextView
                android:id="@+id/tvLowStock"
                style="@style/Widget.App.Tag.Warning"
                android:text="@string/low_stock"
                android:visibility="gone"
                tools:visibility="visible" />

            <TextView
                android:id="@+id/tvInactive"
                style="@style/Widget.App.Tag.Inactive"
                android:text="@string/status_inactive"
                android:visibility="gone" />
        </com.google.android.material.chip.ChipGroup>
    </LinearLayout>
</com.google.android.material.card.MaterialCardView>
