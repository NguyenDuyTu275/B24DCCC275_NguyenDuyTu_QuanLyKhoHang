<?xml version="1.0" encoding="utf-8"?>
<!-- Màn hình 3: Thêm sản phẩm -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    tools:context=".AddProductActivity">

    <com.google.android.material.appbar.MaterialToolbar
        android:id="@+id/toolbar"
        style="@style/Widget.App.Toolbar"
        android:layout_width="match_parent"
        android:layout_height="?attr/actionBarSize"
        app:navigationContentDescription="@string/content_desc_back"
        app:navigationIcon="@drawable/ic_arrow_back"
        app:title="@string/title_add_product" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@color/background"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="4dp"
            android:paddingEnd="16dp"
            android:paddingBottom="24dp">

            <!-- (1) Tên sản phẩm -->
            <TextView
                style="@style/Widget.App.Label"
                android:text="@string/label_name" />

            <EditText
                android:id="@+id/etName"
                style="@style/Widget.App.EditText"
                android:hint="@string/hint_name"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="textCapSentences"
                android:maxLength="100"
                android:maxLines="1" />

            <!-- (2) Giá bán: chỉ nhập số -->
            <TextView
                style="@style/Widget.App.Label"
                android:text="@string/label_price" />

            <EditText
                android:id="@+id/etPrice"
                style="@style/Widget.App.EditText"
                android:hint="@string/hint_price"
                android:imeOptions="actionNext"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="12" />

            <!-- (3) Số lượng: số nguyên không âm -->
            <TextView
                style="@style/Widget.App.Label"
                android:text="@string/label_quantity" />

            <EditText
                android:id="@+id/etQuantity"
                style="@style/Widget.App.EditText"
                android:hint="@string/hint_quantity"
                android:imeOptions="actionDone"
                android:importantForAutofill="no"
                android:inputType="number"
                android:maxLength="9" />

            <!-- (4) Loại sản phẩm -->
            <TextView
                style="@style/Widget.App.Label"
                android:text="@string/label_category" />

            <Spinner
                android:id="@+id/spCategory"
                android:layout_width="match_parent"
                android:layout_height="52dp"
                android:background="@drawable/bg_spinner"
                android:popupBackground="@color/surface"
                android:spinnerMode="dropdown" />

            <!-- (5) Đang kinh doanh (mặc định bật) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="14dp"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:labelFor="@id/swActive"
                    android:text="@string/label_active"
                    android:textColor="@color/text_primary"
                    android:textSize="17sp" />

                <com.google.android.material.materialswitch.MaterialSwitch
                    android:id="@+id/swActive"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:checked="true" />
            </LinearLayout>

            <!-- (6) Mô tả nhiều dòng, không bắt buộc -->
            <TextView
                style="@style/Widget.App.Label"
                android:text="@string/label_description" />

            <EditText
                android:id="@+id/etDescription"
                style="@style/Widget.App.EditText"
                android:gravity="top|start"
                android:hint="@string/hint_description"
                android:importantForAutofill="no"
                android:inputType="textMultiLine|textCapSentences"
                android:maxLength="500"
                android:minLines="3" />

            <!-- (7) Nút Lưu sản phẩm -->
            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnSave"
                style="@style/Widget.App.Button"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                android:text="@string/action_save_product" />
        </LinearLayout>
    </ScrollView>
</LinearLayout>
